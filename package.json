{
  "name": "omo-herdr",
  "version": "0.1.0",
  "description": "Report OMO Native lifecycle and session identity to Herdr",
  "repository": { "type": "git", "url": "git+https://github.com/mastertyko/omo-herdr.git" },
  "bugs": { "url": "https://github.com/mastertyko/omo-herdr/issues" },
  "homepage": "https://github.com/mastertyko/omo-herdr#readme",
  "license": "MIT",
  "keywords": ["omo", "senpi", "pi-package", "herdr", "terminal", "agent-status"],
  "packageManager": "bun@1.3.14",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["src", "README.md", "LICENSE", "SECURITY.md", "CONTRIBUTING.md"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "bun run typecheck && bun run test",
    "qa:host": "node scripts/qa-host.ts",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "bun run check && npm pack --dry-run"
  },
  "engines": { "node": ">=24.0.0" },
  "peerDependencies": { "@code-yeongyu/senpi": ">=2026.9.12" },
  "peerDependenciesMeta": { "@code-yeongyu/senpi": { "optional": true } },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.9.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
