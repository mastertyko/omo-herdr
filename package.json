{
  "name": "omo-herdr",
  "version": "0.1.0",
  "description": "Report OMO Native lifecycle and session identity to Herdr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastertyko/omo-herdr.git"
  },
  "bugs": {
    "url": "https://github.com/mastertyko/omo-herdr/issues"
  },
  "homepage": "https://github.com/mastertyko/omo-herdr#readme",
  "license": "MIT",
  "keywords": [
    "omo",
    "senpi",
    "pi-package",
    "herdr",
    "terminal",
    "agent-status"
  ],
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "profiles",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "web/dist/client"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "bun run typecheck && bun run test && bun run build:web",
    "qa:host": "node scripts/qa-host.ts",
    "qa:live": "node scripts/qa-live.ts",
    "qa:download-herdr": "node scripts/download-herdr.ts",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "bun run check && npm pack --dry-run",
    "build:web": "npm --prefix web run build",
    "dev": "npm --prefix web run dev --",
    "prepack": "npm run build:web",
    "qa:web": "node scripts/qa-web.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": ">=2026.9.12"
  },
  "peerDependenciesMeta": {
    "@code-yeongyu/senpi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.9.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
